// === feature_model.als — Alloy 6 model for Hospital Clinical Record Access ===
// Feature folder: C-L2 / spec branch: 012-hospital-clinical-records
// Generated by spec-led-eval design-mode pipeline.

// ============================================================
// Roles  (spec.md FR-002, data-model.md UserRole enum)
// ============================================================
abstract sig Role {}
one sig Doctor, Nurse, Pharmacist, ClinicalAdmin, HospitalAdministrator extends Role {}

// ============================================================
// Operation kinds  (data-model.md AccessType enum)
// ============================================================
abstract sig OperationKind {}
one sig RecordLookup, AddNote, ListAudit extends OperationKind {}

// ============================================================
// Access outcomes  (data-model.md AccessOutcome enum)
// ============================================================
abstract sig Outcome {}
one sig Permitted, Denied, NotFoundOrDenied extends Outcome {}

// ============================================================
// Authorisation bases  (data-model.md AuthorisationBasis enum)
// ============================================================
abstract sig AuthBasis {}
one sig AuthBasis_CareTeamMember, AuthBasis_NotCareTeamMember,
         AuthBasis_PatientNotFound, AuthBasis_AdministratorRole extends AuthBasis {}

// ============================================================
// Permission matrix — singleton-sig field
// (contracts/http-api.md authorisation tables; spec.md FR-004, FR-005, FR-017)
// ============================================================
one sig PermMatrix {
  Allowed: set Role -> OperationKind
}

fact F_PermissionMatrix {
  // Closed-world: every allowed (Role × OperationKind) cell enumerated.
  // Clinical roles may use the two clinical endpoints (care-team check is additional).
  // HospitalAdministrator may only use the audit-list endpoint.
  PermMatrix.Allowed =
    (Doctor            -> RecordLookup) +
    (Doctor            -> AddNote)      +
    (Nurse             -> RecordLookup) +
    (Nurse             -> AddNote)      +
    (Pharmacist        -> RecordLookup) +
    (Pharmacist        -> AddNote)      +
    (ClinicalAdmin     -> RecordLookup) +
    (ClinicalAdmin     -> AddNote)      +
    (HospitalAdministrator -> ListAudit)
}

// ============================================================
// Domain entities
// ============================================================

sig User {
  userRole: one Role
}

sig Patient {}

// Active care-team membership row: clinician is on patient's care team.
// (data-model.md CareTeamMembership; spec.md FR-004)
sig CareTeamMembership {
  ctmClinician: one User,
  ctmPatient:   one Patient
}

// Append-only clinical notes.  (spec.md FR-010, FR-011; data-model.md ClinicalNote)
sig ClinicalNote {
  notePatient:            one Patient,
  noteAuthor:             one User,
  noteAuthorRoleSnapshot: one Role
}

// Immutable audit entries.  (spec.md FR-012, FR-013, FR-014; data-model.md AuditEntry)
sig AuditEntry {
  aeAccessor:     one User,
  aeRoleSnapshot: one Role,
  aePatient:      one Patient,
  aeOperation:    one OperationKind,
  aeOutcome:      one Outcome,
  aeAuthBasis:    one AuthBasis,
  aeLinkedNote:   lone ClinicalNote
}

// AccessAttempt: one authenticated request processed by the service layer.
// Unauthenticated requests never reach the service layer (FR-001), so every
// AccessAttempt has a resolved caller.  (spec.md FR-001, FR-012)
sig AccessAttempt {
  aaCaller:      one User,
  aaOperation:   one OperationKind,
  aaPatient:     one Patient,
  aaOutcome:     one Outcome,
  aaCreatedNote: lone ClinicalNote,
  aaAuditEntry:  one AuditEntry
}

// ============================================================
// F_NonEmptyUniverse — at least one atom of every dynamic sig
// ============================================================
fact F_NonEmptyUniverse {
  some User
  some Patient
  some CareTeamMembership
  some ClinicalNote
  some AuditEntry
  some AccessAttempt
}

// ============================================================
// Structural facts
// ============================================================

// Care-team membership rows only link clinical-role users
// (data-model.md: ClinicalNote.author_role excludes hospital_administrator)
fact F_CareTeamClinicalRolesOnly {
  all m: CareTeamMembership |
    m.ctmClinician.userRole in (Doctor + Nurse + Pharmacist + ClinicalAdmin)
}

// Each AuditEntry is produced by exactly one AccessAttempt (append-only; no sharing)
fact F_AuditEntryBelongsToOneAttempt {
  all ae: AuditEntry | one aa: AccessAttempt | aa.aaAuditEntry = ae
}

// Audit fields faithfully reflect the AccessAttempt that produced them
fact F_AuditEntryMatchesAttempt {
  all aa: AccessAttempt | {
    aa.aaAuditEntry.aeAccessor   = aa.aaCaller
    aa.aaAuditEntry.aePatient    = aa.aaPatient
    aa.aaAuditEntry.aeOperation  = aa.aaOperation
    aa.aaAuditEntry.aeOutcome    = aa.aaOutcome
  }
}

// Role snapshot in every AuditEntry equals the accessor's actual role
fact F_AuditRoleSnapshotMatchesCaller {
  all ae: AuditEntry | ae.aeRoleSnapshot = ae.aeAccessor.userRole
}

// Each ClinicalNote is created by at most one AccessAttempt (append-only)
fact F_NoteCreatedByOneAttempt {
  all n: ClinicalNote | lone aa: AccessAttempt | aa.aaCreatedNote = n
}

// A note is created if and only if the attempt is a permitted AddNote
fact F_NoteOnlyOnPermittedAddNote {
  all aa: AccessAttempt | {
    (aa.aaOperation = AddNote and aa.aaOutcome = Permitted) implies
      (one n: ClinicalNote | aa.aaCreatedNote = n)
    not (aa.aaOperation = AddNote and aa.aaOutcome = Permitted) implies
      no aa.aaCreatedNote
  }
}

// Audit linked-note is set iff the attempt was a permitted AddNote
fact F_AuditLinkedNoteConsistency {
  all aa: AccessAttempt | {
    (aa.aaOperation = AddNote and aa.aaOutcome = Permitted) implies
      aa.aaAuditEntry.aeLinkedNote = aa.aaCreatedNote
    not (aa.aaOperation = AddNote and aa.aaOutcome = Permitted) implies
      no aa.aaAuditEntry.aeLinkedNote
  }
}

// Care-team membership is necessary and sufficient for a clinical-op Permitted outcome
fact F_CareTeamGating {
  // Permitted on clinical ops ⟹ active care-team membership exists
  all aa: AccessAttempt |
    (aa.aaOperation in (RecordLookup + AddNote) and aa.aaOutcome = Permitted) implies
      (some m: CareTeamMembership |
         m.ctmClinician = aa.aaCaller and m.ctmPatient = aa.aaPatient)
  // No care-team membership ⟹ cannot be Permitted on clinical ops
  all aa: AccessAttempt |
    (aa.aaOperation in (RecordLookup + AddNote) and
     no m: CareTeamMembership |
       m.ctmClinician = aa.aaCaller and m.ctmPatient = aa.aaPatient) implies
      aa.aaOutcome != Permitted
}

// Only clinical roles may obtain Permitted on clinical endpoints
fact F_ClinicalRoleForClinicalOps {
  all aa: AccessAttempt |
    (aa.aaOperation in (RecordLookup + AddNote) and aa.aaOutcome = Permitted) implies
      aa.aaCaller.userRole in (Doctor + Nurse + Pharmacist + ClinicalAdmin)
}

// HospitalAdministrator cannot get Permitted on clinical endpoints
fact F_AdminCannotAccessClinicalContent {
  all aa: AccessAttempt |
    aa.aaCaller.userRole = HospitalAdministrator implies
      aa.aaOperation not in (RecordLookup + AddNote) or aa.aaOutcome != Permitted
}

// Only HospitalAdministrator may get Permitted on the audit-list endpoint
fact F_AdminOnlyListAudit {
  all aa: AccessAttempt |
    (aa.aaOperation = ListAudit and aa.aaOutcome = Permitted) implies
      aa.aaCaller.userRole = HospitalAdministrator
}

// Every Permitted attempt is within the role-level permission matrix
fact F_OperationWithinPermMatrix {
  all aa: AccessAttempt |
    aa.aaOutcome = Permitted implies
      aa.aaCaller.userRole -> aa.aaOperation in PermMatrix.Allowed
}

// Note author must be a clinical role; snapshot must match actual role
fact F_NoteAuthorMustBeClinical {
  all n: ClinicalNote |
    n.noteAuthor.userRole in (Doctor + Nurse + Pharmacist + ClinicalAdmin)
}

fact F_NoteAuthorRoleSnapshotMatches {
  all n: ClinicalNote | n.noteAuthorRoleSnapshot = n.noteAuthor.userRole
}

// Authorisation-basis correctness
fact F_AuthBasisCorrectness {
  all aa: AccessAttempt | {
    (aa.aaOutcome = Permitted and aa.aaOperation in (RecordLookup + AddNote)) implies
      aa.aaAuditEntry.aeAuthBasis = AuthBasis_CareTeamMember
    (aa.aaOutcome = Permitted and aa.aaOperation = ListAudit) implies
      aa.aaAuditEntry.aeAuthBasis = AuthBasis_AdministratorRole
    (aa.aaOutcome = Denied and aa.aaOperation in (RecordLookup + AddNote)) implies
      aa.aaAuditEntry.aeAuthBasis = AuthBasis_NotCareTeamMember
    aa.aaOutcome = NotFoundOrDenied implies
      aa.aaAuditEntry.aeAuthBasis in
        (AuthBasis_PatientNotFound + AuthBasis_NotCareTeamMember)
  }
}

// Byte-equivalent unauthorised envelope: Denied and NotFoundOrDenied
// are grouped into the same response class — the model captures this by
// forbidding any information beyond the outcome atom itself being extractable
// from an attempt whose outcome is not Permitted.
// (spec.md FR-006; contracts/http-api.md byte-equivalent not-found response)
fact F_ByteEquivalentDenialGrouping {
  // All non-Permitted clinical-op attempts carry only "denied or not-found" auth bases
  all aa: AccessAttempt |
    (aa.aaOperation in (RecordLookup + AddNote) and aa.aaOutcome != Permitted) implies
      aa.aaAuditEntry.aeAuthBasis in
        (AuthBasis_NotCareTeamMember + AuthBasis_PatientNotFound)
}

// ============================================================
// Helper predicates (used inside assertions)
// ============================================================

pred isClinicalRole[r: Role] {
  r in (Doctor + Nurse + Pharmacist + ClinicalAdmin)
}

pred hasCareTeamMembership[u: User, p: Patient] {
  some m: CareTeamMembership | m.ctmClinician = u and m.ctmPatient = p
}

// ============================================================
// PATTERN-BASED PREDICATES AND ASSERTIONS
// ============================================================

// PATTERN: LeastPrivilege  ANCHOR: contracts/http-api.md authorisation tables; spec.md FR-004, FR-005, FR-017
pred LeastPrivilege {
  // Every Permitted outcome respects the matrix
  some AccessAttempt
  all aa: AccessAttempt |
    aa.aaOutcome = Permitted implies
      aa.aaCaller.userRole -> aa.aaOperation in PermMatrix.Allowed
  // HospitalAdministrator never obtains Permitted on clinical endpoints
  all aa: AccessAttempt |
    aa.aaCaller.userRole = HospitalAdministrator implies
      not (aa.aaOperation in (RecordLookup + AddNote) and aa.aaOutcome = Permitted)
  // Clinical roles never obtain Permitted on the audit endpoint
  all aa: AccessAttempt |
    isClinicalRole[aa.aaCaller.userRole] implies
      not (aa.aaOperation = ListAudit and aa.aaOutcome = Permitted)
}

assert LeastPrivilege { LeastPrivilege }
check LeastPrivilege for 8 but exactly 5 Role, exactly 3 OperationKind

// PATTERN: PermissionCompleteness  ANCHOR: contracts/http-api.md permission tables; spec.md FR-002
pred PermissionCompleteness {
  // Every (Role × OperationKind) pair is either in Allowed or not — all pairs covered.
  // We assert the Allowed set equals exactly the closed-world enumeration.
  some AccessAttempt
  PermMatrix.Allowed =
    (Doctor            -> RecordLookup) +
    (Doctor            -> AddNote)      +
    (Nurse             -> RecordLookup) +
    (Nurse             -> AddNote)      +
    (Pharmacist        -> RecordLookup) +
    (Pharmacist        -> AddNote)      +
    (ClinicalAdmin     -> RecordLookup) +
    (ClinicalAdmin     -> AddNote)      +
    (HospitalAdministrator -> ListAudit)
}

assert PermissionCompleteness { PermissionCompleteness }
check PermissionCompleteness for 8 but exactly 5 Role, exactly 3 OperationKind

// PATTERN: AuthRequiredEverywhere  ANCHOR: spec.md FR-001; contracts/http-api.md §Authentication
pred AuthRequiredEverywhere {
  // Every modelled AccessAttempt has a resolved caller (one User).
  // Unauthenticated requests never produce an AccessAttempt atom.
  some AccessAttempt
  all aa: AccessAttempt | one aa.aaCaller
}

assert AuthRequiredEverywhere { AuthRequiredEverywhere }
check AuthRequiredEverywhere for 8

// PATTERN: AuditCompleteness  ANCHOR: spec.md FR-012, SC-001, SC-002; data-model.md AuditEntry
pred AuditCompleteness {
  // Every AccessAttempt has exactly one AuditEntry.
  some AccessAttempt
  all aa: AccessAttempt | one aa.aaAuditEntry
  // Every AuditEntry is produced by exactly one AccessAttempt (no orphan audit rows).
  all ae: AuditEntry | (one aa: AccessAttempt | aa.aaAuditEntry = ae)
}

assert AuditCompleteness { AuditCompleteness }
check AuditCompleteness for 8

// PATTERN: AppendOnly  ANCHOR: spec.md FR-011, FR-014; data-model.md "no UPDATE/DELETE"
pred AppendOnly {
  // Each ClinicalNote is the product of at most one AccessAttempt (no edit path exists).
  some ClinicalNote
  all n: ClinicalNote | (lone aa: AccessAttempt | aa.aaCreatedNote = n)
  // Each AuditEntry belongs to exactly one AccessAttempt (no mutation path).
  all ae: AuditEntry | (one aa: AccessAttempt | aa.aaAuditEntry = ae)
}

assert AppendOnly { AppendOnly }
check AppendOnly for 8

// PATTERN: AttributionCorrectness  ANCHOR: spec.md FR-010, FR-013; data-model.md AuditEntry snapshot fields
pred AttributionCorrectness {
  // AuditEntry role snapshot = accessor's actual role; Patient matches attempt.
  some AuditEntry
  all ae: AuditEntry | ae.aeRoleSnapshot = ae.aeAccessor.userRole
  all aa: AccessAttempt | {
    aa.aaAuditEntry.aeAccessor  = aa.aaCaller
    aa.aaAuditEntry.aePatient   = aa.aaPatient
    aa.aaAuditEntry.aeOperation = aa.aaOperation
    aa.aaAuditEntry.aeOutcome   = aa.aaOutcome
  }
  // Note's author role snapshot = author's actual role
  all n: ClinicalNote | n.noteAuthorRoleSnapshot = n.noteAuthor.userRole
}

assert AttributionCorrectness { AttributionCorrectness }
check AttributionCorrectness for 8

// PATTERN: OwnershipBasedAccess  ANCHOR: spec.md FR-004; data-model.md CareTeamMembership
pred OwnershipBasedAccess {
  // Permitted on a clinical endpoint ⟺ care-team membership exists for that (user, patient).
  some AccessAttempt
  all aa: AccessAttempt |
    (aa.aaOperation in (RecordLookup + AddNote) and aa.aaOutcome = Permitted) implies
      (some m: CareTeamMembership |
         m.ctmClinician = aa.aaCaller and m.ctmPatient = aa.aaPatient)
  all aa: AccessAttempt |
    (aa.aaOperation in (RecordLookup + AddNote) and
     no m: CareTeamMembership |
       m.ctmClinician = aa.aaCaller and m.ctmPatient = aa.aaPatient) implies
      aa.aaOutcome != Permitted
}

assert OwnershipBasedAccess { OwnershipBasedAccess }
check OwnershipBasedAccess for 8

// PATTERN: NoInformationLeakage  ANCHOR: spec.md FR-006, SC-003; contracts/http-api.md byte-equivalent not-found
pred NoInformationLeakage {
  // Non-Permitted clinical-op outcomes carry only denied/not-found auth bases —
  // the two cases are indistinguishable at the response layer.
  some AccessAttempt
  all aa: AccessAttempt |
    (aa.aaOperation in (RecordLookup + AddNote) and aa.aaOutcome != Permitted) implies
      aa.aaAuditEntry.aeAuthBasis in
        (AuthBasis_NotCareTeamMember + AuthBasis_PatientNotFound)
  // In particular, the auth-basis does not distinguish "admin tried clinical op"
  // from "non-team clinician tried" — both map to the same denial group.
  all aa: AccessAttempt |
    (aa.aaCaller.userRole = HospitalAdministrator and
     aa.aaOperation in (RecordLookup + AddNote)) implies
      aa.aaAuditEntry.aeAuthBasis in
        (AuthBasis_NotCareTeamMember + AuthBasis_PatientNotFound)
}

assert NoInformationLeakage { NoInformationLeakage }
check NoInformationLeakage for 8

// ============================================================
// FEATURE-SPECIFIC PREDICATES AND ASSERTIONS
// ============================================================

// FEATURE-SPECIFIC  ANCHOR: FR-001 — unauthenticated requests never create AuditEntries
pred FR_001_AuthRequired {
  // Every AuditEntry traces to a resolved User; no AuditEntry exists without a caller.
  some AuditEntry
  all ae: AuditEntry | one ae.aeAccessor
  // Equivalently: there is no AuditEntry whose accessor is unresolved — enforced
  // by the `one` multiplicity on aeAccessor; the predicate makes it checkable.
  all ae: AuditEntry | ae.aeAccessor in User
}

assert FR_001_AuthRequired { FR_001_AuthRequired }
check FR_001_AuthRequired for 8

// FEATURE-SPECIFIC  ANCHOR: FR-002 — every user's role is from the v1 catalogue
pred FR_002_RoleFromCatalogue {
  some User
  all u: User |
    u.userRole in (Doctor + Nurse + Pharmacist + ClinicalAdmin + HospitalAdministrator)
}

assert FR_002_RoleFromCatalogue { FR_002_RoleFromCatalogue }
check FR_002_RoleFromCatalogue for 8

// FEATURE-SPECIFIC  ANCHOR: FR-004 — care-team membership gating, evaluated per request
pred FR_004_CareTeamGating {
  some AccessAttempt
  // Clinical-op Permitted ⟹ membership exists
  all aa: AccessAttempt |
    (aa.aaOperation in (RecordLookup + AddNote) and aa.aaOutcome = Permitted) implies
      (some m: CareTeamMembership |
         m.ctmClinician = aa.aaCaller and m.ctmPatient = aa.aaPatient)
  // No membership ⟹ not Permitted
  all aa: AccessAttempt |
    (aa.aaOperation in (RecordLookup + AddNote) and
     not hasCareTeamMembership[aa.aaCaller, aa.aaPatient]) implies
      aa.aaOutcome != Permitted
}

assert FR_004_CareTeamGating { FR_004_CareTeamGating }
check FR_004_CareTeamGating for 8

// FEATURE-SPECIFIC  ANCHOR: FR-005 — administrator cannot read clinical content
pred FR_005_AdminNoClinicAccess {
  some AccessAttempt
  all aa: AccessAttempt |
    aa.aaCaller.userRole = HospitalAdministrator implies
      not (aa.aaOperation in (RecordLookup + AddNote) and aa.aaOutcome = Permitted)
}

assert FR_005_AdminNoClinicAccess { FR_005_AdminNoClinicAccess }
check FR_005_AdminNoClinicAccess for 8

// FEATURE-SPECIFIC  ANCHOR: FR-006 — byte-equivalent denial (denied and not-found produce same auth-basis group)
pred FR_006_ByteEquivalentDenial {
  some AccessAttempt
  all aa: AccessAttempt |
    (aa.aaOperation in (RecordLookup + AddNote) and aa.aaOutcome != Permitted) implies
      aa.aaAuditEntry.aeAuthBasis in
        (AuthBasis_NotCareTeamMember + AuthBasis_PatientNotFound)
}

assert FR_006_ByteEquivalentDenial { FR_006_ByteEquivalentDenial }
check FR_006_ByteEquivalentDenial for 8

// FEATURE-SPECIFIC  ANCHOR: FR-009 — validation before mutation; no note on failed validation
pred FR_009_ValidationBeforeMutation {
  // A ClinicalNote exists only when the corresponding attempt was Permitted AddNote.
  some ClinicalNote
  all n: ClinicalNote |
    (some aa: AccessAttempt |
       aa.aaCreatedNote = n and aa.aaOperation = AddNote and aa.aaOutcome = Permitted)
  // No note is created for any non-Permitted attempt.
  all aa: AccessAttempt |
    aa.aaOutcome != Permitted implies no aa.aaCreatedNote
}

assert FR_009_ValidationBeforeMutation { FR_009_ValidationBeforeMutation }
check FR_009_ValidationBeforeMutation for 8

// FEATURE-SPECIFIC  ANCHOR: FR-010 — note fields: author attribution, role snapshot
pred FR_010_NoteAttribution {
  some ClinicalNote
  all n: ClinicalNote | {
    // Author is a clinical-role user
    isClinicalRole[n.noteAuthor.userRole]
    // Role snapshot faithful to author's actual role
    n.noteAuthorRoleSnapshot = n.noteAuthor.userRole
  }
}

assert FR_010_NoteAttribution { FR_010_NoteAttribution }
check FR_010_NoteAttribution for 8

// FEATURE-SPECIFIC  ANCHOR: FR-011 — notes append-only; each note is created by at most one attempt
pred FR_011_NotesAppendOnly {
  some ClinicalNote
  // No ClinicalNote is the aaCreatedNote of more than one AccessAttempt
  all n: ClinicalNote | (lone aa: AccessAttempt | aa.aaCreatedNote = n)
  // Every ClinicalNote traces to exactly one Permitted AddNote attempt
  all n: ClinicalNote |
    (one aa: AccessAttempt |
       aa.aaCreatedNote = n and aa.aaOperation = AddNote and aa.aaOutcome = Permitted)
}

assert FR_011_NotesAppendOnly { FR_011_NotesAppendOnly }
check FR_011_NotesAppendOnly for 8

// FEATURE-SPECIFIC  ANCHOR: FR-012 — always-on audit; one entry per attempt regardless of outcome
pred FR_012_AlwaysOnAudit {
  some AccessAttempt
  // Every AccessAttempt has exactly one AuditEntry
  all aa: AccessAttempt | one aa.aaAuditEntry
  // Every AuditEntry is produced by exactly one AccessAttempt
  all ae: AuditEntry | (one aa: AccessAttempt | aa.aaAuditEntry = ae)
  // Audit captures all three possible outcomes
  all aa: AccessAttempt |
    aa.aaAuditEntry.aeOutcome = aa.aaOutcome
}

assert FR_012_AlwaysOnAudit { FR_012_AlwaysOnAudit }
check FR_012_AlwaysOnAudit for 8

// FEATURE-SPECIFIC  ANCHOR: FR-013 — audit entry carries correct linked-note iff add_note+permitted
pred FR_013_AuditNoteIdField {
  some AuditEntry
  all aa: AccessAttempt | {
    (aa.aaOperation = AddNote and aa.aaOutcome = Permitted) implies
      (one n: ClinicalNote |
         aa.aaAuditEntry.aeLinkedNote = n and aa.aaCreatedNote = n)
    not (aa.aaOperation = AddNote and aa.aaOutcome = Permitted) implies
      no aa.aaAuditEntry.aeLinkedNote
  }
}

assert FR_013_AuditNoteIdField { FR_013_AuditNoteIdField }
check FR_013_AuditNoteIdField for 8

// FEATURE-SPECIFIC  ANCHOR: FR-014 — audit entries immutable; each belongs to exactly one attempt
pred FR_014_AuditImmutability {
  some AuditEntry
  // No two AccessAttempts share an AuditEntry
  all disj aa1, aa2: AccessAttempt | aa1.aaAuditEntry != aa2.aaAuditEntry
  // Every AuditEntry has exactly one parent attempt
  all ae: AuditEntry | (one aa: AccessAttempt | aa.aaAuditEntry = ae)
}

assert FR_014_AuditImmutability { FR_014_AuditImmutability }
check FR_014_AuditImmutability for 8

// FEATURE-SPECIFIC  ANCHOR: FR-017 — audit-list endpoint is administrator-only
pred FR_017_AdminOnlyAuditEndpoint {
  some AccessAttempt
  all aa: AccessAttempt |
    (aa.aaOperation = ListAudit and aa.aaOutcome = Permitted) implies
      aa.aaCaller.userRole = HospitalAdministrator
  // Clinical roles never get Permitted on ListAudit
  all aa: AccessAttempt |
    isClinicalRole[aa.aaCaller.userRole] implies
      not (aa.aaOperation = ListAudit and aa.aaOutcome = Permitted)
}

assert FR_017_AdminOnlyAuditEndpoint { FR_017_AdminOnlyAuditEndpoint }
check FR_017_AdminOnlyAuditEndpoint for 8

// FEATURE-SPECIFIC  ANCHOR: FR-018 — administrator's audit response contains no clinical content
// Modelled as: no AuditEntry referencing a ListAudit attempt exposes ClinicalNote data.
// The aeLinkedNote field is the only note-related field on AuditEntry; it is set to
// null for list_audit operations, ensuring no note body is reachable from an admin response.
pred FR_018_AdminContentBlindness {
  some AccessAttempt
  // AuditEntries produced by ListAudit attempts carry no linked note
  all aa: AccessAttempt |
    aa.aaOperation = ListAudit implies no aa.aaAuditEntry.aeLinkedNote
  // HospitalAdministrator's attempts never create a ClinicalNote
  all aa: AccessAttempt |
    aa.aaCaller.userRole = HospitalAdministrator implies no aa.aaCreatedNote
}

assert FR_018_AdminContentBlindness { FR_018_AdminContentBlindness }
check FR_018_AdminContentBlindness for 8

// FEATURE-SPECIFIC  ANCHOR: FR-013 / FR-002 — audit role snapshot drawn from v1 catalogue
pred FR_013_AuditRoleSnapshotValid {
  some AuditEntry
  all ae: AuditEntry |
    ae.aeRoleSnapshot in (Doctor + Nurse + Pharmacist + ClinicalAdmin + HospitalAdministrator)
  all ae: AuditEntry | ae.aeRoleSnapshot = ae.aeAccessor.userRole
}

assert FR_013_AuditRoleSnapshotValid { FR_013_AuditRoleSnapshotValid }
check FR_013_AuditRoleSnapshotValid for 8

// === D3 inject_violation (validator-appended) ===
fact MUTATE_AdminOnlyListAudit { some aa: AccessAttempt | aa.aaCaller.userRole = Doctor and aa.aaOperation = ListAudit and aa.aaOutcome = Permitted }

// === D3 over-constraint probe (validator-appended) ===
assert __D3_OverConstraintProbe { some none }
check __D3_OverConstraintProbe for 5
